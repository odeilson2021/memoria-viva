# Credenciais do banco de dados para o servidor MCP MySQL
# NÃO versionar este arquivo — adicione .env.mcp ao .gitignore
#
# Copie este arquivo: cp .env.mcp.example .env.mcp
# Preencha com suas credenciais locais ou de desenvolvimento.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=nome_do_banco
MYSQL_USER=usuario
MYSQL_PASSWORD=senha_aqui
MYSQL_CHARSET=utf8mb4
